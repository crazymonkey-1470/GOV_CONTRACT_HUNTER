# ----------------------------------------------------------------------------
# ContractHunter LIMS SCRAPER environment (Python — scraper/)
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# (This is separate from the frontend's `env.example`, which configures the
#  Next.js dashboard with the public anon key.)
# ----------------------------------------------------------------------------

# --- Supabase (service-role key: bypasses RLS to insert rows) ---------------
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- SAM.gov Opportunities API ----------------------------------------------
# sam.gov -> Account Details -> API Key
SAM_API_KEY=your-sam-api-key

# --- Anthropic (OPTIONAL) ---------------------------------------------------
# Only used to phrase customer_fit_notes from real notice text. Leave blank to
# skip LLM enrichment entirely (the scraper still runs and inserts rows).
ANTHROPIC_API_KEY=

# --- Firecrawl (self-hosted or cloud) ---------------------------------------
# Base URL of your Firecrawl server, e.g. https://firecrawl.your-domain.com
FIRECRAWL_URL=https://your-firecrawl-host
FIRECRAWL_API_KEY=

# --- Tunables (optional) ----------------------------------------------------
# How many days back to search SAM postings (widened up to 90 only if empty).
LOOKBACK_DAYS=14
