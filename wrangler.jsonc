// Cloudflare Workers config for the ContractHunter dashboard (Next.js via OpenNext).
// "name" must match the Worker in the Cloudflare dashboard (gov-contract-hunter).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gov-contract-hunter",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // No "build" block: Workers Builds runs `npm run cf:build` as its build command,
  // and a build here would run a second, slower build during `wrangler deploy`.
  "observability": {
    "enabled": true
  }
}
